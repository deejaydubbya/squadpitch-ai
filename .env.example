SP_AI_APP_ENV=development
SP_AI_LOG_LEVEL=INFO
SP_AI_API_HOST=0.0.0.0
SP_AI_API_PORT=8080
SP_AI_POSTGRES_DSN=
SP_AI_REDIS_URL=
SP_AI_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
SP_AI_WORKER_HEARTBEAT_TTL_SECONDS=360
SP_AI_OTEL_SERVICE_NAME=squadpitch-ai
SP_AI_REQUEST_TIMEOUT_SECONDS=30
SP_AI_SERVICE_AUTH_SECRETS=primary:replace-with-shared-hmac-secret
SP_AI_SERVICE_AUTH_NONCE_STORE_MAX_ENTRIES=10000
SP_AI_BUILD_SHA=                    # Deployed commit/build identifier for provenance
SP_AI_SENTRY_DSN=                   # Runtime secret; use a dedicated AI project DSN
SP_AI_SENTRY_ENVIRONMENT=production
SP_AI_SENTRY_RELEASE=               # Optional; defaults to build SHA/Fly image metadata
SP_AI_SENTRY_TRACES_SAMPLE_RATE=0   # OTel owns tracing; Sentry captures errors without duplicate traces
SP_AI_SENTRY_DELIVERY_VERIFIED=     # Date/event reference after dashboard confirmation
